{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "apiUrl",
      "type": "promptString",
      "description": "Enter the API URL (e.g., https://api.example.com/api)",
      "default": "https://test.api.ap.system32.uk/api"
    }
  ],
  "tasks": [
    {
      "label": "Install Frontend Dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "cwd": "${workspaceFolder}/frontend",
      "problemMatcher": "$npm",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Start Frontend Dev Server",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "cd ${workspaceFolder}/frontend && bash generate-config.sh && npm start"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Compiled successfully!",
          "endsPattern": "^webpack.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Start Frontend Dev Server (with API)",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "cd ${workspaceFolder}/frontend && REACT_APP_API_URL='${input:apiUrl}' bash generate-config.sh && npm start"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Compiled successfully!",
          "endsPattern": "^webpack.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Stop Frontend Dev Server",
      "type": "shell",
      "command": "pkill",
      "args": ["-f", "react-scripts start"],
      "windows": {
        "command": "taskkill",
        "args": ["/IM", "node.exe", "/F"]
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Backend Dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pip",
      "args": ["install", "-r", "backend/requirements/common.in"],
      "cwd": "${workspaceFolder}/backend",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "uvicorn", "backend_fastapi.asgi:application", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting development server",
          "endsPattern": "Quit the server"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "env": {
        "PYTHONUNBUFFERED": "1",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv"
      }
    },
    {
      "label": "Start FastAPI Server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend_fastapi",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running on",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "env": {
        "PYTHONUNBUFFERED": "1",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv"
      }
    },
    {
      "label": "Stop FastAPI Server",
      "type": "shell",
      "command": "pkill",
      "args": ["-f", "uvicorn main:app"],
      "windows": {
        "command": "taskkill",
        "args": ["/IM", "python.exe", "/F"]
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Both Servers",
      "dependsOn": [
        "Start Frontend Dev Server",
        "Start Backend Server"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Start Frontend + FastAPI",
      "dependsOn": [
        "Start Frontend Dev Server",
        "Start FastAPI Server"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Install All Dependencies",
      "dependsOn": [
        "Install Frontend Dependencies",
        "Install Backend Dependencies"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "cwd": "${workspaceFolder}/frontend",
      "problemMatcher": "$npm",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Run Frontend Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "cwd": "${workspaceFolder}/frontend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Run Backend Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["manage.py", "test"],
      "cwd": "${workspaceFolder}/backend",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "env": {
        "PYTHONUNBUFFERED": "1",
        "VIRTUAL_ENV": "${workspaceFolder}/.venv"
      }
    }
  ]
}
