# Caddyfile for local development
# Maps requests to frontend and backend services

localhost {
    # Frontend app
    handle /api* {
        reverse_proxy backend:8000
    }

    # Frontend static and index
    handle {
        reverse_proxy frontend:3000
    }
}

# Also serve on local IP for cross-container testing
0.0.0.0:8080 {
    # Frontend app
    handle /api* {
        reverse_proxy backend:8000
    }

    # Frontend static and index
    handle {
        reverse_proxy frontend:3000
    }
}
